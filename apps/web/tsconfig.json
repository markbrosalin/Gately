{
    "extends": "@cnbn/typescript-config/vite.json",
    "include": ["src"],
    "exclude": ["node_modules", "dist"],
    "compilerOptions": {
        "target": "esnext",
        "moduleResolution": "bundler",
        "module": "ESNext",
        "lib": ["esnext", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "types": ["vite/client"],
        "paths": {
            "@gately/*": ["./src/*"],
            "@engine-components/*": ["./src/shared/infrastructure/ui-engine/components/*"],
            "@engine-model/*": ["./src/shared/infrastructure/ui-engine/model/*"],
            "engine-presets/*": ["./src/shared/infrastructure/ui-engine/presets/*"],
            "index.css": ["./src/index.css"]
        },
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js"
    }
}
